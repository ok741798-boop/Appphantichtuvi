# Không bắt buộc. Để trống thì app dùng lời luận rule-based.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Danh sách origin được phép gọi API, cách nhau bằng dấu phẩy.
CORS_ORIGINS=*

HOST=127.0.0.1
PORT=5057
FLASK_DEBUG=0

# Chỉ cần khi máy không có sẵn Arial hoặc DejaVu Sans để xuất PDF.
PDF_FONT_PATH=
PDF_FONT_BOLD_PATH=
